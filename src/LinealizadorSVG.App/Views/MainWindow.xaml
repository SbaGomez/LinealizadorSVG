<Window x:Class="LinealizadorSVG.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LinealizadorSVG.App.ViewModels"
        Title="Linealizador SVG" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" Drop="AlSoltar" DragOver="AlArrastrar" DragLeave="AlSalirArrastre">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AbrirArchivoCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding GuardarCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="OcultoSiNulo" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Paso" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: brand, how to export from CorelDRAW, credit -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="/Assets/app.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Linealizador SVG" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontSize="11.5"
                               Text="Funciona sin internet. Nunca modifica el archivo original."/>
                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,12,0,10"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="Hecho por"/>
                        <Hyperlink NavigateUri="https://sebastiangomez.com.ar" RequestNavigate="AbrirLink"
                                   ToolTip="sebastiangomez.com.ar" FocusVisualStyle="{x:Null}">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextDecorations" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            <Run Text="Sebastian Gomez"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="DESDE CORELDRAW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Paso}" Text="1. Convertí los textos a curvas (Ctrl&#x2060;+&#x2060;Q)."/>
                    <TextBlock Style="{StaticResource Paso}" Text="2. Exportá como SVG."/>
                    <TextBlock Style="{StaticResource Paso}" Text="3. Cargalo acá y guardá la versión para Bambu."/>
                    <TextBlock Style="{StaticResource Paso}" Text="4. Importá el archivo _BAMBU.svg en Bambu Studio."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,24" MaxWidth="820" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource Iconos}" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,2,12,0"/>
                    <TextBlock Text="SVG para Bambu Studio" Style="{StaticResource PageTitle}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Descripcion}"
                           Text="Convierte las curvas en segmentos rectos y reconstruye el SVG limpio: sin grupos, CSS ni estilos heredados de CorelDRAW. Conserva los subcontornos y las medidas. Regla de relleno por orden: el primer trazado nonzero y los siguientes evenodd (el perfil validado con el logo de GymUP)."/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                <!-- Drop zone -->
                <Grid MinHeight="130">
                    <Rectangle x:Name="Zona" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="5 3"
                               Stroke="{StaticResource InputBorderBrush}" Fill="{StaticResource SidebarBrush}"/>
                    <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Iconos}" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"
                                   Text="Arrastrá tu SVG acá, o"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AbrirArchivoCommand}" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Abrir SVG (Ctrl+O)"/>
                            </StackPanel>
                        </Button>
                        <TextBlock HorizontalAlignment="Center" FontSize="12.5" Margin="0,10,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Text="{Binding NombreArchivo}"
                                   Tag="{Binding NombreArchivo}" Style="{StaticResource OcultoSiNulo}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Precisión de linealización" Style="{StaticResource InputLabel}"/>
                    <ComboBox ItemsSource="{Binding Precisiones}" SelectedItem="{Binding Precision}" DisplayMemberPath="Nombre"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,0"
                               Text="Largo máximo de cada segmento recto, en unidades del SVG. Más chico es más fiel a la curva pero el archivo pesa más."/>
                </StackPanel>
                </Grid>

                <Border Padding="14" CornerRadius="8" Background="#FBEAEA" BorderBrush="#F2C4C4" BorderThickness="1" Margin="0,0,0,14"
                        Tag="{Binding Error}" Style="{StaticResource OcultoSiNulo}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="13.5"/>
                </Border>

                <!-- Result -->
                <Border Style="{StaticResource Tarjeta}" Visibility="{Binding HayResultado, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock FontSize="13" Foreground="{StaticResource MutedTextBrush}">
                                    <Run Text="{Binding Resumen, Mode=OneWay}"/>
                                    <Run Foreground="{StaticResource AccentBrush}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Text" Value="  · convirtiendo…"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Convirtiendo}" Value="False">
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Guardar SVG para Bambu (Ctrl+S)"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AbrirCarpetaCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GuardadoEn}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Mostrar en la carpeta"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Estado}" Foreground="{StaticResource SuccessBrush}" FontSize="12.5" Margin="0,-4,0,12"
                                   TextWrapping="Wrap" Tag="{Binding Estado}" Style="{StaticResource OcultoSiNulo}"/>

                        <Border Background="{StaticResource DeskBrush}" CornerRadius="8" Padding="16" Height="380">
                            <Image Source="{Binding Vista}" Stretch="Uniform" RenderOptions.EdgeMode="Unspecified"/>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Así queda con sus rellenos: si un hueco aparece tapado o una parte vacía, revisalo antes de imprimir."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
