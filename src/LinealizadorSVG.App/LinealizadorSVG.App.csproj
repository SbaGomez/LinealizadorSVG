<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LinealizadorSVG</AssemblyName>
    <RootNamespace>LinealizadorSVG.App</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Shown in the exe's Properties > Details. -->
    <Authors>Sebastian Gomez</Authors>
    <Company>Sebastian Gomez</Company>
    <Product>Linealizador SVG</Product>
    <Copyright>© 2026 Sebastian Gomez</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Keep the published folder to the single exe (no package XML docs next to it). -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinealizadorSVG.Core\LinealizadorSVG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/taskbar icon and sidebar logo; ApplicationIcon above only sets the exe's icon in Explorer. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
